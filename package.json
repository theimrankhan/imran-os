  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "dev:server": "npm run dev:server --prefix server",
    "postinstall": "cd server && npm install && npx prisma generate",
